# Banco de dados. Local: arquivo SQLite. Producao: Turso (libsql://...) + token.
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""

# Sessao (login do painel e da conta de cliente): 32+ caracteres aleatorios.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Primeiro usuario do painel, criado pelo `npm run db:seed`.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Endereco publico do site (usado em links absolutos, SEO e Mercado Pago).
NEXT_PUBLIC_SITE_URL="https://www.maqcentercascavel.com.br"

# Mercado Pago (Checkout Pro). Credenciais em https://www.mercadopago.com.br/developers/panel
# Use o token TEST-... para testar sem cobrar.
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta das notificacoes (Webhooks > Assinatura secreta).
MERCADOPAGO_WEBHOOK_SECRET=""

# Imagens enviadas pelo painel em producao (Vercel Blob).
BLOB_READ_WRITE_TOKEN=""

# E-mail do formulario de contato (Resend). O dominio do remetente precisa estar verificado.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""
